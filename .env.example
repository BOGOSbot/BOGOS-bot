# Required
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord
COMMAND_PREFIX=!

# STT model/runtime
STT_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=fr
STT_BEAM_SIZE=1
STT_MIN_AUDIO_BYTES=3200
# Anti-hallucination guards (ASR models invent text for silence).
# Floor: drop utterances quieter than this before spending a request.
STT_MIN_SPEECH_DBFS=-60
# A VAD segment shorter than this is padding and a click, not a word.
STT_MIN_UTTERANCE_SECONDS=0.5
# Level: lift quiet speakers toward this target (max gain capped).
STT_NORMALIZE_DBFS=-20
STT_MAX_GAIN_DB=24
# Plausibility: nobody speaks faster than this. Real fast French measured
# 5.9 words/s; fabrications started at 8.6.
STT_MAX_WORDS_PER_SECOND=7
STT_MIN_WORDS_GRACE=5
STT_FALLBACK_MODEL_ID=base
STT_FALLBACK_DEVICE=cpu
STT_FALLBACK_COMPUTE_TYPE=int8

# Process and queue safety
USER_TIMEOUT_SECONDS=60
SPEECH_FLUSH_TIMEOUT_SECONDS=2.0
RESULT_POLL_INTERVAL=0.05
AUDIO_QUEUE_MAXSIZE=512
RESULT_QUEUE_MAXSIZE=128
COMMAND_QUEUE_MAXSIZE=128
STT_HEALTH_CHECK_INTERVAL=2.0
SHUTDOWN_TIMEOUT_SECONDS=10.0

# Voice activity detection -- the segment length knob.
# 100 ms (silero's default) cuts at the first inter-word pause and shreds
# the transcript. Raise if output is still fragmentary, lower for snappier.
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_SECONDS=25

# Backend: local (faster-whisper) or openrouter (cloud STT endpoint).
STT_BACKEND=local
OPENROUTER_API_KEY=
STT_API_MODEL=openai/gpt-transcribe
# A second model, run on every utterance only to find where the two
# readings disagree. The bot then prints both and the reader decides; no
# model judges another, because the wrong reading is usually the fluent
# one and a judge reading text alone would prefer it.
# Prices are per second of audio: gpt is $0.27/hour of speech, voxtral
# $0.18, so this adds spend rather than certainty. Empty turns it off.
# Models: curl 'https://openrouter.ai/api/v1/models?output_modalities=transcription'
STT_SECOND_OPINION=mistralai/voxtral-small-24b-2507-stt
STT_API_TIMEOUT=120
# Parallel transcription workers (cloud STT is network-bound).
STT_WORKERS=4
# Exit after this long with no activity, so an auto-pausing host can
# sleep. 0 disables it - set 0 on a PC or an always-on VPS.
IDLE_EXIT_MINUTES=15
# One LLM pass over the finished transcript at !stop. It never edits silently:
# only changed lines are posted, removals struck through, additions in italics.
CLEANUP_ENABLED=false
CLEANUP_MODEL=deepseek/deepseek-v4.1-flash
CLEANUP_TIMEOUT=180

# Audio on disk
# Both of these write other people's voices to disk, and both are owned by the
# widget's Record switch: the widget writes recording.json, and that file wins
# over whatever is set here. These are the fallback for running without it.
# Empty disables. See recording.py for the file format and the resolution order.
STT_DUMP_DIR=
# One continuous WAV per speaker per session, uncut by the VAD, so a corpus can
# be rebuilt and the thresholds re-tuned on identical material.
RECORD_DIR=

# Transcript output
# 0 = post to the channel the command was used in
TRANSCRIPT_CHANNEL_ID=0
TRANSCRIPT_FLUSH_INTERVAL=2.0
TRANSCRIPT_MAX_LINES=12
TRANSCRIPT_SAVE_DIR=transcripts

# Logging
LOG_LEVEL=INFO
# End-of-session reconciliation
# Nothing is posted while a session runs. At !stop, one LLM pass settles the
# differences the mechanical reconciler could not: the same meaning said
# differently, or a reading that was fabricated. It is told to keep both
# readings when it cannot tell, because it never hears the audio and the
# wrong reading is usually the fluent one.
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
SENSENOVA_API_KEY=
# Reconciler: one key variable covers whichever provider RECONCILE_BASE_URL
# points at, so switching means changing all three together.
# DeepSeek, used while testing: settled 18 disputed lines in 84 seconds.
RECONCILE_MODELS=deepseek-flash
RECONCILE_BASE_URL=https://api.deepseek.com/v1
RECONCILE_API_KEY=
# Deployment: SenseNova's free tier. Its chat models are tried in order, so a
# busy one can fall through to the next.
# RECONCILE_MODELS=sensenova-6.8-flash-lite
# RECONCILE_BASE_URL=https://token.sensenova.ai/v1
RECONCILE_REASONING=low
RECONCILE_TIMEOUT=75

# Required
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord
COMMAND_PREFIX=!

# STT model/runtime
STT_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=fr
STT_BEAM_SIZE=1
STT_MIN_AUDIO_BYTES=8000
# Anti-hallucination guards (ASR models invent text for silence).
# Floor: drop utterances quieter than this before spending a request.
STT_MIN_SPEECH_DBFS=-60
# A VAD segment shorter than this is padding and a click, not a word.
STT_MIN_UTTERANCE_SECONDS=0.5
# Level: lift quiet speakers toward this target (max gain capped).
STT_NORMALIZE_DBFS=-20
STT_MAX_GAIN_DB=24
# Plausibility: nobody speaks faster than this. Real fast French measured
# 5.9 words/s; fabrications started at 8.6.
STT_MAX_WORDS_PER_SECOND=7
STT_MIN_WORDS_GRACE=5
STT_FALLBACK_MODEL_ID=base
STT_FALLBACK_DEVICE=cpu
STT_FALLBACK_COMPUTE_TYPE=int8

# Process and queue safety
USER_TIMEOUT_SECONDS=60
SPEECH_FLUSH_TIMEOUT_SECONDS=2.0
RESULT_POLL_INTERVAL=0.05
AUDIO_QUEUE_MAXSIZE=512
RESULT_QUEUE_MAXSIZE=128
COMMAND_QUEUE_MAXSIZE=128
STT_HEALTH_CHECK_INTERVAL=2.0
SHUTDOWN_TIMEOUT_SECONDS=10.0

# Voice activity detection -- the segment length knob.
# 100 ms (silero's default) cuts at the first inter-word pause and shreds the
# transcript; 600 ms was measured and still refused a quarter of a session's
# chunks for being under a second. Raise for longer utterances, lower for
# snappier ones.
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=1500
VAD_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_SECONDS=25

# Backend: local (faster-whisper on this machine) or openrouter (the cloud).
# The chunked design below is the point of this bot, and it needs the cloud.
STT_BACKEND=openrouter
# Get a key at https://openrouter.ai/keys. The widget writes it into this file
# for you: click the key line at the bottom of the panel, paste, SAVE. It stays
# on this machine and .gitignore keeps it out of the repository.
OPENROUTER_API_KEY=
STT_API_TIMEOUT=120
# Parallel transcription workers (cloud STT is network-bound).
STT_WORKERS=4
# Exit after this long with no activity, so an auto-pausing host can
# sleep. 0 disables it - set 0 on a PC or an always-on VPS.
IDLE_EXIT_MINUTES=15
# One LLM pass over the finished transcript at !stop. It never edits silently:
# only changed lines are posted, removals struck through, additions in italics.
CLEANUP_ENABLED=false
CLEANUP_MODEL=deepseek/deepseek-v4.1-flash
CLEANUP_TIMEOUT=180

# Audio on disk
# Both of these write other people's voices to disk, and both are owned by the
# widget's Record switch: the widget writes recording.json, and that file wins
# over whatever is set here. These are the fallback for running without it.
# Empty disables. See recording.py for the file format and the resolution order.
STT_DUMP_DIR=
# One continuous WAV per speaker per session, uncut by the VAD, so a corpus can
# be rebuilt and the thresholds re-tuned on identical material.
RECORD_DIR=

# Transcript output
# 0 = post to the channel the command was used in
TRANSCRIPT_CHANNEL_ID=0
TRANSCRIPT_FLUSH_INTERVAL=2.0
TRANSCRIPT_MAX_LINES=12
TRANSCRIPT_SAVE_DIR=transcripts

# Logging
LOG_LEVEL=INFO
# Chunked transcription
# One request per chunk, sent as soon as the chunk is full, so a long session
# is settled while it runs. The provider caps a request at 20 MB and base64
# inflates by a third, so 16 kHz mono tops out near 7.8 minutes.
#
# Two routes; the widget switches between them, and a switch applies at the
# next start because a config is read once, when the bot boots. Voxtral
# is the default: on this team's recordings it punctuates better and drops no
# words, and it takes the vocabulary as context_bias. Gemini takes the audio as
# a content part of a chat request and the vocabulary as prose in the prompt.
# Voxtral is billed per second of audio, about $0.24 per hour of speech sent;
# Gemini's is about $0.16 with the glossary cached.
STT_CHUNK_PROVIDER=voxtral
STT_CHUNK_MODEL=mistralai/voxtral-small-transcribe-3-0
# flash, not flash-lite: the lite tier answers a chunk with its opening
# sentence and stops, and which chunks it does that to is unpredictable.
STT_CHUNK_MODEL_GEMINI=google/gemini-2.5-flash
# Voxtral is told the language; it takes no prompt at all.
STT_CHUNK_LANGUAGE=fr
# The provider slug the vocabulary is sent under, from the endpoints API.
STT_BIAS_PROVIDER=mistral
STT_CHUNK_SECONDS=60
STT_CHUNK_MAX_SECONDS=450
# A chunk also closes when the next utterance arrives this long after its
# first. Audio is not time: without this an intermittent speaker holds one
# chunk open for minutes and the transcript reads as a single moment.
STT_CHUNK_MAX_SPAN_SECONDS=90
STT_CHUNK_GAP_SECONDS=0.4
# A ceiling on a runaway, not a length the model needs: the longest honest
# reading of a 90s chunk is about 400 tokens. One of these recordings was once
# answered to a 4,096-token cap with "Hmm." repeated, which cost a cent.
STT_CHUNK_MAX_TOKENS=2048
STT_CHUNK_TIMEOUT=600
# A chunk that reads back far thinner than its audio, or as a loop, is re-asked
# once with a prompt that names the failure.
STT_CHUNK_ATTEMPTS=2
# The proper nouns to expect, one per line, attached to every chunk. A relative
# path resolves against the project root; empty turns it off, and so does a
# missing file. It is read fresh before each request, so adding a word applies
# to the next chunk.
# The whole Warhammer 40,000 corpus is about 42,000 tokens, which is 95% of a
# one-minute chunk, so this stays a core vocabulary and not a corpus. See
# glossary.txt for the list and how to tune it.
STT_GLOSSARY_FILE=glossary.txt
# A second list, read after the first, for what does not belong in a public
# repository: your armies, your players, the venue, the gite. Gitignored and
# absent by default.
STT_GLOSSARY_LOCAL_FILE=glossary.local.txt
# The prompt is the only place the Gemini route can learn what it is hearing.
# Naming the setting is what makes it spell the names the way the table did.
# The Voxtral route has no prompt; its vocabulary is the glossary above.
STT_CHUNK_PROMPT=Transcribe this audio. It is a French-speaking Warhammer 40,000 tournament team: they are reviewing army lists, agreeing pairings and matchups, and organising travel, accommodation and payment. Return only the transcript, in French, one paragraph per utterance. Do not summarise it, do not translate it, and do not describe the audio.
